        400        DEFINE PROFLOW STREAM-VAR STREAM=S32 SUBSTREAM=MIXED  &
        401            VARIABLE=MOLE-FLOW UOM="kmol/hr"
        402        DEFINE ESPECN LOCAL-PARAM
        403        DEFINE ESPECST LOCAL-PARAM
        404    F     WEL = WLK1 + WLK2 + WPK1 - WTURB1
        405    F     VM0  = 22.414
        406    F     VM15 = 22.414*(288.15/273.15)
        407    F     V0  = PROFLOW * VM0
        408    F     V15 = PROFLOW * VM15
        409    F     ESPECN  = WEL / V0
        410    F     ESPECST = WEL / V15
        411        READ-VARS WLK1 WTURB1 WLK2 WPK1 PROFLOW
        412        WRITE-VARS ESPECN ESPECST
