        275    CALCULATOR KOMPV
        276        DEFINE P BLOCK-VAR BLOCK=LK2 VARIABLE=PRES SENTENCE=PARAM  &
        277            UOM="bar"
        278        DEFINE PIN STREAM-VAR STREAM=S1 SUBSTREAM=MIXED  &
        279            VARIABLE=PRES UOM="bar"
        280        DEFINE PINT BLOCK-VAR BLOCK=LK1 VARIABLE=PRES  &
        281            SENTENCE=PARAM UOM="bar"
        282    F     DP = 0.1
        283    F     DISCR  = DP*DP + 4.0*PIN*P
        284    F     P1OUT  = (DP + SQRT(DISCR)) / 2.0
        285    F     PINT   = P1OUT
        286        READ-VARS P PIN
        287        WRITE-VARS PINT
        288        EXECUTE BEFORE BLOCK LK1
