       280    1    DEFINE PINT BLOCK-VAR BLOCK=LK1 VARIABLE=PRES  &                                                                                                                                                                                                            
       281    1        SENTENCE=PARAM UOM="BAR"                                                                                                                                                                                                                                
       282    1F     DP = 0.1                                                                                                                                                                                                                                                  
       283    1F     DISCR  = DP*DP + 4.0*PIN*P                                                                                                                                                                                                                                
       284    1F     P1OUT  = (DP + SQRT(DISCR)) / 2.0                                                                                                                                                                                                                         
       285    1F     PINT   = P1OUT                                                                                                                                                                                                                                            
       286    1    READ-VARS P PIN                                                                                                                                                                                                                                             
       287    1    WRITE-VARS PINT                                                                                                                                                                                                                                             
