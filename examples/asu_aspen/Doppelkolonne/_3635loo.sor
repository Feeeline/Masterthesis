       389    1    DEFINE WLK1 BLOCK-VAR BLOCK=LK1 VARIABLE=NET-WORK  &                                                                                                                                                                                                        
       390    1        SENTENCE=RESULTS UOM="KW"                                                                                                                                                                                                                               
       391    1    DEFINE WLK2 BLOCK-VAR BLOCK=LK2 VARIABLE=NET-WORK  &                                                                                                                                                                                                        
       392    1        SENTENCE=RESULTS UOM="KW"                                                                                                                                                                                                                               
       393    1    DEFINE WPK1 BLOCK-VAR BLOCK=PK1 VARIABLE=NET-WORK  &                                                                                                                                                                                                        
       394    1        SENTENCE=RESULTS UOM="KW"                                                                                                                                                                                                                               
       395    1    DEFINE WTURB1 BLOCK-VAR BLOCK=T VARIABLE=NET-WORK  &                                                                                                                                                                                                        
       396    1        SENTENCE=RESULTS UOM="KW"                                                                                                                                                                                                                               
       397    1    DEFINE PROFLOW STREAM-VAR STREAM=S32 SUBSTREAM=MIXED  &                                                                                                                                                                                                     
       398    1        VARIABLE=MOLE-FLOW UOM="KMOL/HR"                                                                                                                                                                                                                        
       399    1    DEFINE ESPECN LOCAL-PARAM                                                                                                                                                                                                                                   
       400    1    DEFINE ESPECST LOCAL-PARAM                                                                                                                                                                                                                                  
       401    1F     WEL = WLK1 + WLK2 + WPK1 - WTURB1                                                                                                                                                                                                                         
       402    1F     VM0  = 22.414                                                                                                                                                                                                                                             
       403    1F     VM15 = 22.414*(288.15/273.15)                                                                                                                                                                                                                             
       404    1F     V0  = PROFLOW * VM0                                                                                                                                                                                                                                       
       405    1F     V15 = PROFLOW * VM15                                                                                                                                                                                                                                      
       406    1F     ESPECN  = WEL / V0                                                                                                                                                                                                                                        
       407    1F     ESPECST = WEL / V15                                                                                                                                                                                                                                       
       408    1    READ-VARS WLK1 WTURB1 WLK2 WPK1 PROFLOW                                                                                                                                                                                                                     
       409    1    WRITE-VARS ESPECN ESPECST                                                                                                                                                                                                                                   
